# Variables this project adds to /opt/supabase/.env (names only — real values
# live on the VPS, chmod 600, never in git). Upstream's own .env is produced
# by setup.sh / utils/generate-keys.sh / utils/add-new-auth-keys.sh.

# Compose layering (RFC-015/016): upstream base + ours. No upstream caddy overlay:
# the public edge is the shared Caddy in /opt/edge.
COMPOSE_FILE=docker-compose.yml:ots/docker-compose.ots.yml

# Public hostname (served by the shared Caddy; see /opt/edge/.env OTS_DOMAIN).
# Wildcard DNS -> the VPS IP; replace with a real domain if one is bought.
SUPABASE_PUBLIC_URL=https://161-97-171-179.sslip.io

# Studio login (also used for Caddy basic auth). Password is generated.
DASHBOARD_USERNAME=

# Project name shown in Studio. Self-hosted Studio has no UI field for it; it is
# read from this variable. After changing: docker compose up -d studio
STUDIO_DEFAULT_PROJECT=discord-ots-bot

# challonge-sync Edge Function secrets — carried over from the hosted project
CHALLONGE_API_KEY=
CHALLONGE_SYNC_SECRET=
