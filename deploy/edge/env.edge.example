# Variables for /opt/edge/.env (names only — real values live on the VPS,
# chmod 600, never in git). One block of variables per site file in sites/.

# --- discord-ots-bot (sites/ots.caddy) ---------------------------------------
OTS_DOMAIN=161-97-171-179.sslip.io
OTS_PROXY_AUTH_USERNAME=
# The password is stored as a bcrypt HASH, in single quotes (it contains `$`):
#   OTS_PROXY_AUTH_PASSWORD='$2a$14$...'
# Generate: docker run --rm caddy:2 caddy hash-password --plaintext '<password>'
# (prints the hash — don't run it in a session whose output is logged).
OTS_PROXY_AUTH_PASSWORD=
# (username = the first stack's DASHBOARD_USERNAME; the password is the hash of
# its DASHBOARD_PASSWORD, which stays plaintext in /opt/supabase/.env)

# --- other projects: add their variables here, with a distinct prefix --------
